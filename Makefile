# =============================================================================
# ee8350 — build system
# =============================================================================

TOP_MODULE  ?= me_top
DESIGN_NAME ?= $(TOP_MODULE)
BUILD_DIR   ?= build
SYNTH_DIR   ?= synth
VCS         ?= vcs

RTL_SOURCES := \
    $(realpath src/hdl/me_pkg.sv) \
    $(realpath src/hdl/sram_if.sv) \
    $(realpath src/hdl/sram_wrapper.sv) \
    $(realpath src/hdl/sram_macro_bb.sv) \
    $(realpath src/hdl/fs/fs_pe.sv) \
    $(realpath src/hdl/fs/fs_pe_array.sv) \
    $(realpath src/hdl/fs/fs_computer.sv) \
	$(realpath src/hdl/fs/fs_combiner.sv) \
	$(realpath src/hdl/fs/fs_comparator.sv) \
	$(realpath src/hdl/fs/fs_control.sv) \
	$(realpath src/hdl/me_top.sv)

HVL_SOURCES := \
	$(realpath src/hvl/tbs/aes_tb.sv) \
	$(realpath src/hvl/tbs/aes_core_adapter.sv) \
	$(realpath src/hvl/bfms/rv_if.sv) \
	$(realpath src/hvl/bfms/ksch_buffer_if.sv) \

SIM_SOURCES := \
	$(realpath src/tb/common/fs_tb_common_pkg.sv)

VCS_FLAGS := -full64 -Mupdate +v2k -sverilog -timescale=1ns/1ns -work build/work -kdb -debug_all \
			 -l compile.log

SVUNIT_OUT   := $(BUILD_DIR)/svunit
SVUNIT_DUT_F := $(abspath $(SVUNIT_OUT)/dut.f)
SVUNIT_DIRS  := --directory ../../src/tb/module --directory ../../src/tb/full

SVUNIT_FLAGS := -s vcs -f $(SVUNIT_DUT_F) \
                -d SVUNIT_TIMEOUT=500000ns \
                -c -full64 -c -Mupdate -c +v2k -c -sverilog -c -timescale=1ns/1ns -c -kdb \
                -c "-l compile.log" \
				-c -debug_acc+all+dmptf -c -debug_region+cell+encrypt \
                -c "+vcs+dumpvars+entire_run.vcd" \
				-c -debug_acc+all+dmptf -c -debug_region+cell+encrypt \
                -c -memcbk

export SVUNIT_INSTALL := $(CURDIR)/lib/svunit
export PATH := $(CURDIR)/lib/svunit/bin:$(PATH)

# ----- Build -----------------------------------------------------------------

.DEFAULT_GOAL := all
all: build

build: $(RTL_SOURCES)
	@mkdir -p build
	@cd $(BUILD_DIR)
	$(VCS) $(VCS_FLAGS) $(RTL_SOURCES) -top $(TOP_MODULE)
	@cd ../

clean:
	rm -rf $(BUILD_DIR) $(FILELIST) *.vcd

# ----- SVUnit -----------------------------------------------------------------

$(SVUNIT_DUT_F): $(RTL_SOURCES)
	@mkdir -p $(dir $@)
	@echo '# generated by make test - do not edit' > $@
	@for f in $(RTL_SOURCES); do echo $$f >> $@; done
	@for f in $(SIM_SOURCES); do echo $$f >> $@; done

test: $(SVUNIT_DUT_F)
	cd $(SVUNIT_OUT) && runSVUnit $(SVUNIT_FLAGS) $(SVUNIT_DIRS)

test-one: $(SVUNIT_DUT_F)
	cd $(SVUNIT_OUT) && runSVUnit $(SVUNIT_FLAGS) -t ../../src/tb/module/$(TEST)

test-module: $(SVUNIT_DUT_F)
	cd $(SVUNIT_OUT) && runSVUnit $(SVUNIT_FLAGS) --directory $(abspath src/tb/module)

test-full: $(SVUNIT_DUT_F)
	cd $(SVUNIT_OUT) && runSVUnit $(SVUNIT_FLAGS) --directory $(abspath src/tb/full)

list-tests: $(SVUNIT_DUT_F)
	cd $(SVUNIT_OUT) && runSVUnit $(SVUNIT_FLAGS) $(SVUNIT_DIRS) --list-tests

# ----- Synthesis --------------------------------------------------------------

DC_HOST   ?= vlsi
DC_DIR    ?=                # remote directory holding this checkout
DC_SCRIPT ?= scripts/dc_flow.tcl
FILELIST  := synth/filelist.f

# Ordered source list; DC requires packages/interfaces to be analyzed before
# the modules that use them, so this mirrors the order above.
filelist: $(FILELIST)

$(FILELIST): $(RTL_SOURCES)
	@mkdir -p $(dir $@)
	@echo '# generated by make filelist - do not edit' > $@
	@for f in $(RTL_SOURCES); do echo $$f >> $@; done

synth: $(FILELIST)
	@echo "==> Running Design Compiler for top module: $(TOP_MODULE)"
	@cd $(SYNTH_DIR) && DESIGN_NAME=$(DESIGN_NAME) TOP_MODULE=$(TOP_MODULE) dc_shell-t -f $(DC_SCRIPT)

.PHONY: all build clean test test-module test-full list-tests filelist synth
